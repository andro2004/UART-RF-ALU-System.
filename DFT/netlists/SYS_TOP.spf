    "_pi" = '"REF_CLK" + "RST" + "RX_IN" + "SE" + "SI" + "UART_CLK" + "scan_clk" 
    + "scan_rst" + "test_mode"';
    "_po" = '"RX_Parity_Error" + "RX_Stop_Error" + "SO" + "TX_OUT" + "TX_OUT_V"'
    ;
}
