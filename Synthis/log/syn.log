while {[gets $fh line] >= 0} {
    set line [string trim $line]
    if {$line eq "" || [string match "//*" $line] || [string match "#*" $line]} { continue }
    if {[string match -nocase "*_tb.*" $line]} { continue }
    lappend rtl_files $line
}
